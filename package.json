{
  "name": "Lambda",
  "version": "1.0.0",
  "description": "A Custom Reverse Proxy with Real-Time Packet Capture and Traffic Analysis",
  "main": "index.js",
  "scripts": {
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "smoke": "pnpm --filter ./apps/proxy smoke",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test"
  },
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "author": "AlyKazani04",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.6.0",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
