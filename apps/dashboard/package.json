{
  "name": "dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "pnpm --filter shared-types run build",
    "build": "next build",
    "pretypecheck": "pnpm --filter shared-types run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "start": "NODE_ENV=production tsx server.ts"
