# Ports
PROXY_PORT=8080
STUB_PORT=3001
DASHBOARD_PORT=3000

# Interface for libpcap capture (find with: ip -br addr)
# MUST be the physical NIC, never `lo` — a container's loopback is
# namespace-isolated and sees no host traffic, so capture goes silent in a way
# that looks exactly like a broken parser. See issue #20 / B1.
# wlp0s20f3 is this machine's WiFi NIC; override per machine in .env.
CAPTURE_IFACE=wlp0s20f3

# Redis. Kept on the compose network, not published to the host or LAN —
# Redis has no auth and no TLS by default.
REDIS_URL=redis://redis:6379

# Upstreams (F2 / A1). The proxy resolves UPSTREAM_HOST and round-robins over
# the addresses it returns, so `docker compose up --scale stub=3` turns into a
# 3-instance rotation with no code change. UPSTREAM_INSTANCES caps how many of
# the resolved addresses are used; it must be >= the number of replicas or the
# extra replicas are never selected.
#
# Compose overrides UPSTREAM_HOST to the service name (`stub`); the localhost
# default is for running the proxy on the host against `pnpm --filter stub dev`.
UPSTREAM_HOST=127.0.0.1
UPSTREAM_PORT=3001
UPSTREAM_INSTANCES=3

# Path routing table, as JSON. Optional — the built-in default is
# [{"prefix":"/api","group":"api"},{"prefix":"/timeline","group":"timeline"}].
# Point a group at specific instances with UPSTREAM_TARGETS (host:port,...) or
# per group with UPSTREAM_TARGETS_<GROUP> (e.g. UPSTREAM_TARGETS_TIMELINE).
# ROUTES=[{"prefix":"/api","group":"api"}]

# Capped history list length (LPUSH + LTRIM frames 0 <HISTORY_LIMIT>)
HISTORY_LIMIT=10000