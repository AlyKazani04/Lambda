# Ports
PROXY_PORT=8080
STUB_PORT=3001
DASHBOARD_PORT=3000

# Interface for libpcap capture (find with: ip -br addr)
# MUST be the physical NIC, never `lo` — a container's loopback is
# namespace-isolated and sees no host traffic, so capture goes silent in a way
# that looks exactly like a broken parser. See issue #20 / B1.
# wlp0s20f3 is this machine's WiFi NIC; override per machine in .env.
CAPTURE_IFACE=wlp0s20f3

# Redis. Kept on the compose network, not published to the host or LAN —
# Redis has no auth and no TLS by default.
REDIS_URL=redis://redis:6379

# Capped history list length (LPUSH + LTRIM frames 0 <HISTORY_LIMIT>)
HISTORY_LIMIT=10000