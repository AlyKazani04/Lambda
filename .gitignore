node_modules

.env

# Local-only compose overrides (LAN exposure, machine-specific ports)
compose.lan.yml
compose.override.yml

*.pcap
# F8 parser-validation fixtures are committed on purpose (binary fixtures are a
# legitimate use); live captures everywhere else stay ignored.
!tools/parser-fixtures/*.pcap

captures/

dist/

# Next.js
.next/
out/

# Logs & coverage
*.log
npm-debug.log*
pnpm-debug.log*
coverage/
*.tsbuildinfo

# Editor / OS
.DS_Store
.idea/
*.swp

# A8: certificate key material is local-only. A committed private key is a
# real incident, so ignore PEM/key files everywhere, including certs/.
certs/
*.pem
*.key

/**/*/PLAN.md
